{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020"],
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowSyntheticDefaultImports": true,
    "typeRoots": ["./types", "./node_modules/@types"],
    "paths": {
      "crypto": ["./types/node-shims"],
      "http": ["./types/node-shims"],
      "events": ["./types/node-shims"]
    }
  },
  "include": ["vite.config.ts"]
}
